# ─── Slack (ingest) ───────────────────────────────────────────────────────────
# User OAuth token (xoxp-...) or bot token (xoxb-...). Scopes:
#   channels:history channels:read  (public)  /  groups:history groups:read (private)
#   users:read  (to resolve author display names)
SLACK_TOKEN=xoxp-your-token-here
# Comma-separated channel IDs (the C... id from "View channel details").
SLACK_CHANNELS=C0123ABCD

# ─── Anthropic (classify + summarize) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_CONCURRENCY=4

# ─── X.com enrichment ──────────────────────────────────────────────────────────
# oEmbed needs no key. Knobs only.
X_OEMBED_TIMEOUT=10
X_ENRICH_NON_X_LINKS=true

# ─── Cognee graph stage ────────────────────────────────────────────────────────
# Graph adapter: pggraph (community) layers pgGraph traversal over Postgres graph
# tables, falling back to SQL when the `graph` extension isn't installed.
GRAPH_DATABASE_PROVIDER=pggraph
GRAPH_DATABASE_HOST=localhost
GRAPH_DATABASE_PORT=5433
GRAPH_DATABASE_NAME=cognee
GRAPH_DATABASE_USERNAME=cognee
GRAPH_DATABASE_PASSWORD=cognee
PGGRAPH_BUILD_MODE=manual

# Relational + vector live in the same Postgres.
DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cognee
DB_USERNAME=cognee
DB_PASSWORD=cognee
VECTOR_DB_PROVIDER=pgvector
ENABLE_BACKEND_ACCESS_CONTROL=false

# Cognee LLM + embeddings. LLM = Anthropic; embeddings = OpenAI (Cognee default).
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-haiku-4-5
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Paths / behavior ──────────────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=INFO
